# ── Autenticación gateway → motor ─────────────────────────────────────────
# Secreto compartido: el gateway lo manda en el header X-API-Key.
MOTOR_API_KEY=

# ── Sheet maestro «FACHADO — Gestión de Obras» ────────────────────────────
FACHADO_SHEET_ID=1yoakmhO1--WXCtWWStNrmczgYkaT1g0H54fTK2QCc9A
# Segundos que se cachean los maestros antes de releer el Sheet.
MAESTROS_TTL_SEGUNDOS=300
# Solo para correr offline: leer los maestros de un JSON en vez del Sheet.
# MAESTROS_SNAPSHOT=tests/maestros_snapshot.json

# ── Google: Sheets con service account ────────────────────────────────────
# La misma service account del gateway, con el Sheet compartido con ella:
#   chatbot-contable@chatbot-contable-495714.iam.gserviceaccount.com
# En Railway se pega el JSON completo en una línea; local alcanza con la ruta.
GOOGLE_CREDENTIALS_JSON=
# GOOGLE_CREDENTIALS_PATH=../chatbot-contable/config/google_credentials.json

# ── Google: Drive con OAuth de usuario (valencampero@gmail.com) ───────────
# Solo para BAJAR los adjuntos: drive.file únicamente llega a los archivos que subió
# este mismo cliente OAuth, que es el que usa el gateway. Generar con:
#   python scripts/get_google_token.py <client_secret.json>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── LLM ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_HABILITADO=true
LLM_MODELO=claude-opus-5
LLM_EFFORT=low

# ── Adjuntos ──────────────────────────────────────────────────────────────
LEER_ADJUNTOS=true
UTC_OFFSET_HORAS=-3
